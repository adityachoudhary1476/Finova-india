---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorSearch from '../components/react/CalculatorSearch';
import {
  calculatorById,
  getLiveCalculatorsByCategory,
  isLiveCalculator,
  liveCalculators,
  liveCategories,
} from '../data/calculators';
import { guidePreviews } from '../data/guides';
import type { CalculatorItem } from '../data/types';

const title = 'Finova — Free Financial Calculators for India';
const description = 'Free financial calculators for EMI, SIP, tax, salary, investments and more. Fast, transparent and built for India.';
const homeUrl = new URL('/', Astro.site ?? Astro.url.origin).toString();
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Finova',
      url: homeUrl,
      description,
      inLanguage: 'en-IN',
    },
    {
      '@type': 'WebPage',
      name: title,
      url: homeUrl,
      description,
      isPartOf: { '@type': 'WebSite', name: 'Finova', url: homeUrl },
    },
  ],
};

const featureSpecs = [
  {
    id: 'home-loan-emi-calculator',
    number: '01',
    chapter: 'Borrowing',
    display: ['Buy with', 'the math.'],
    note: 'Monthly repayment, total interest and the long view — before you sign.',
  },
  {
    id: 'sip-calculator',
    number: '02',
    chapter: 'Investing',
    display: ['Small steps,', 'long horizon.'],
    note: 'Separate what you put in from the growth an assumed return could produce.',
  },
  {
    id: 'income-tax-calculator',
    number: '03',
    chapter: 'Tax',
    display: ['Compare', 'the regimes.'],
    note: 'An AY 2026–27 estimate with slabs, deductions, rebate and cess shown clearly.',
  },
  {
    id: 'salary-calculator',
    number: '04',
    chapter: 'Pay',
    display: ['From CTC to', 'take-home.'],
    note: 'See how employer costs and payroll deductions shape monthly in-hand salary.',
  },
] as const;

const featuredTools = featureSpecs
  .map((feature) => ({ ...feature, calculator: calculatorById.get(feature.id) }))
  .filter((feature): feature is typeof feature & { calculator: CalculatorItem } => isLiveCalculator(feature.calculator));

const principles = [
  ['01', 'Visible workings', 'Inputs, formulas and result breakdowns are shown instead of hidden behind a score.'],
  ['02', 'Local by design', 'Rupee formatting, lakh and crore notation, and clearly dated Indian rules.'],
  ['03', 'No account required', 'The current tools work without profiles, sign-ins or saved personal information.'],
  ['04', 'Estimates, labelled', 'Assumptions and limitations stay next to the numbers they affect.'],
] as const;
---

<BaseLayout title={title} description={description} canonicalPath="/" structuredData={homeStructuredData}>
  <div class="editorial-home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="site-container hero__edition">
        <span>FINANCIAL UTILITIES / INDIA</span>
        <span class="tabular-nums">VOL. 01 — 2026</span>
      </div>

      <div class="site-container hero__grid">
        <div class="hero__copy">
          <h1 id="hero-title">
            <span>Money,</span>
            <span>in plain</span>
            <em>numbers.</em>
          </h1>

          <div class="hero__intro">
            <p>Free, transparent calculators for the decisions that follow you home.</p>
            <span aria-hidden="true">↘</span>
          </div>

          <div id="calculator-search" class="hero__search">
            <CalculatorSearch client:load />
          </div>
        </div>

        <figure class="hero-figure">
          <div class="hero-figure__stamp" aria-hidden="true">
            <span>THE</span><strong>MONEY</strong><span>ISSUE</span>
          </div>
          <div class="hero-figure__image">
            <img
              src="/images/finova-editorial-still-life.jpg"
              width="928"
              height="1152"
              alt="An open financial ledger with hand-drawn charts, a calculator and a rupee token on a green desk"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption>
            <span>Numbers become useful when the assumptions are visible.</span>
            <span class="tabular-nums">PLATE 01 / FINOVA</span>
          </figcaption>

          <div class="hero-figure__data" aria-label="Illustrative SIP projection: ten thousand rupees monthly for fifteen years at an assumed twelve percent return gives an estimated value of fifty lakh forty-five thousand seven hundred sixty rupees">
            <span>A SIP illustration</span>
            <strong class="tabular-nums">₹50,45,760</strong>
            <div>
              <span>₹10K / month</span>
              <span>15 years</span>
              <span>12% assumed</span>
            </div>
          </div>
        </figure>
      </div>

      <div class="site-container hero__footnote">
        <span>{liveCalculators.length} live tools</span>
        <span>No sign-in</span>
        <span>Clear assumptions</span>
        <a href="/methodology">Read the methodology <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="tool-stories" aria-labelledby="tools-title">
      <div class="site-container">
        <header class="section-intro" data-reveal>
          <span class="kicker">THE TOOL INDEX / 01</span>
          <h2 id="tools-title">Start with the <em>question.</em></h2>
          <p>Not a dashboard. Not a product pitch. Just a direct route from the money question to the useful number.</p>
        </header>

        <div class="tool-list">
          {featuredTools.map((feature) => (
            <a class="tool-story" href={feature.calculator.route} data-reveal>
              <span class="tool-story__number tabular-nums">{feature.number}</span>
              <span class="tool-story__chapter">{feature.chapter}</span>
              <span class="tool-story__title">
                <strong>{feature.display[0]}</strong>
                <em>{feature.display[1]}</em>
              </span>
              <span class="tool-story__note">{feature.note}</span>
              <span class="tool-story__arrow" aria-hidden="true">↗</span>
              <span class="sr-only">Open {feature.calculator.name}</span>
            </a>
          ))}
        </div>

        <a class="text-link tool-stories__all" href="/calculators">
          See all {liveCalculators.length} calculators <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="worked-example" aria-labelledby="example-title">
      <div class="site-container worked-example__head" data-reveal>
        <span class="kicker">ONE HABIT / ONE HORIZON / ONE ASSUMPTION</span>
        <h2 id="example-title">Watch a monthly habit become a <em>future number.</em></h2>
      </div>

      <div class="site-container worked-example__body">
        <div class="example-sequence" data-reveal>
          <div class="example-step">
            <span class="example-step__label">Put in</span>
            <strong class="tabular-nums">₹10,000</strong>
            <small>at the beginning of every month</small>
          </div>
          <span class="example-sequence__operator" aria-hidden="true">×</span>
          <div class="example-step">
            <span class="example-step__label">Stay for</span>
            <strong class="tabular-nums">15 years</strong>
            <small>180 regular contributions</small>
          </div>
          <span class="example-sequence__operator" aria-hidden="true">+</span>
          <div class="example-step">
            <span class="example-step__label">Assume</span>
            <strong class="tabular-nums">12%</strong>
            <small>constant annual return</small>
          </div>
        </div>

        <div class="example-result" data-reveal>
          <div class="example-result__copy">
            <span class="example-result__label">Estimated value</span>
            <p class="example-result__number">
              <span class="sr-only">Fifty lakh forty-five thousand seven hundred sixty rupees</span>
              <span class="example-result__currency" aria-hidden="true">₹</span><span class="tabular-nums" data-count="5045760" aria-hidden="true">50,45,760</span>
            </p>
            <div class="example-result__split">
              <span><small>You invest</small><strong class="tabular-nums">₹18,00,000</strong></span>
              <span><small>Estimated growth</small><strong class="tabular-nums">₹32,45,760</strong></span>
            </div>
            <a href="/calculators/sip">Try your own SIP numbers <span aria-hidden="true">↗</span></a>
          </div>

          <figure class="growth-figure">
            <svg viewBox="0 0 620 360" role="img" aria-labelledby="growth-title growth-desc">
              <title id="growth-title">Illustrative SIP growth over fifteen years</title>
              <desc id="growth-desc">A line rises gradually at first and more quickly later, reaching an estimated fifty lakh forty-five thousand seven hundred sixty rupees after fifteen years.</desc>
              <g class="growth-figure__grid" aria-hidden="true">
                <path d="M40 40H590M40 108H590M40 176H590M40 244H590M40 312H590" />
                <path d="M40 40V312M150 40V312M260 40V312M370 40V312M480 40V312M590 40V312" />
              </g>
              <path class="growth-figure__area" d="M40 300 C112 290 150 278 205 258 C280 230 317 211 370 177 C439 132 493 84 590 44 L590 312 L40 312 Z" aria-hidden="true" />
              <path class="growth-figure__line" pathLength="1" d="M40 300 C112 290 150 278 205 258 C280 230 317 211 370 177 C439 132 493 84 590 44" aria-hidden="true" />
              <circle class="growth-figure__point" cx="590" cy="44" r="7" aria-hidden="true" />
              <g class="growth-figure__labels" aria-hidden="true">
                <text x="40" y="338">START</text>
                <text x="570" y="338">15Y</text>
              </g>
            </svg>
            <figcaption>Projection only — actual market returns vary and may be negative.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="catalogue" aria-labelledby="catalogue-title">
      <div class="site-container">
        <div class="catalogue__heading" data-reveal>
          <span class="kicker">THE FULL INDEX / 02</span>
          <h2 id="catalogue-title">Four ways into the numbers.</h2>
          <p>Every category and count below is drawn from the calculators that are live now.</p>
        </div>

        <div class="catalogue__list">
          {liveCategories.map((category, index) => {
            const tools = getLiveCalculatorsByCategory(category.id);
            return (
              <section class="catalogue-row" aria-labelledby={`category-${category.id}`} data-reveal>
                <span class="catalogue-row__number tabular-nums">{String(index + 1).padStart(2, '0')}</span>
                <h3 id={`category-${category.id}`}>{category.title}</h3>
                <p>{category.description}</p>
                <div class="catalogue-row__tools">
                  {tools.map((tool) => <a href={tool.route}>{tool.shortName}</a>)}
                </div>
                <a class="catalogue-row__category" href={`/calculators/category/${category.id}`} aria-label={`Browse ${category.title} calculators`}>
                  {tools.length} {tools.length === 1 ? 'tool' : 'tools'} <span aria-hidden="true">↗</span>
                </a>
              </section>
            );
          })}
        </div>
      </div>
    </section>

    <section class="money-101" aria-labelledby="money-title">
      <div class="site-container money-101__masthead" data-reveal>
        <span class="kicker">PLAIN-ENGLISH NOTES / 03</span>
        <h2 id="money-title"><span>Money</span><em>101</em></h2>
        <p>Because a result is more useful when you understand what moved it.</p>
      </div>

      <div class="site-container money-101__stories">
        {guidePreviews.map((guide, index) => (
          <article class:list={['money-story', { 'money-story--lead': index === 0 }]} data-reveal>
            <div class="money-story__meta">
              <span>{guide.category}</span>
              <span class="tabular-nums">{guide.readTime}</span>
            </div>
            <span class="money-story__index tabular-nums" aria-hidden="true">0{index + 1}</span>
            <h3><a href={`/guides/${guide.slug}`}>{guide.title}</a></h3>
            <p>{guide.description}</p>
            <a class="money-story__read" href={`/guides/${guide.slug}`} aria-label={`Read ${guide.title}`}>
              Read the note <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>

      <div class="site-container money-101__footer">
        <a class="text-link" href="/guides">Browse all guides <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="principles" aria-labelledby="principles-title">
      <div class="site-container principles__heading" data-reveal>
        <span class="kicker">THE FINOVA STANDARD / 04</span>
        <h2 id="principles-title">Clarity is the feature.</h2>
        <a href="/methodology">How our calculations work <span aria-hidden="true">↗</span></a>
      </div>
      <div class="site-container principles__list">
        {principles.map(([number, heading, copy]) => (
          <article class="principle" data-reveal>
            <span class="tabular-nums">{number}</span>
            <h3>{heading}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="final-statement" aria-labelledby="final-title">
      <div class="site-container final-statement__inner" data-reveal>
        <span class="final-statement__mark" aria-hidden="true">₹</span>
        <div>
          <span class="kicker">YOUR NEXT MOVE</span>
          <h2 id="final-title">Know the number.<br /><em>Then decide.</em></h2>
        </div>
        <div class="final-statement__action">
          <p>Use the tools freely. Read the assumptions. Keep the decision yours.</p>
          <a href="/calculators">Open the calculator index <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <aside class="estimate-note" aria-labelledby="estimate-note-title">
      <div class="site-container estimate-note__inner">
        <h2 id="estimate-note-title">A note on estimates</h2>
        <p>Finova provides calculations for informational and educational purposes. Results can vary with actual rates, product terms, changing rules and individual circumstances.</p>
        <a href="/disclaimer">Read the disclaimer <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = [...document.querySelectorAll('[data-reveal]')];
    root.classList.add('motion-ready');

    if (reduceMotion || !('IntersectionObserver' in window)) {
      reveals.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    reveals.forEach((element) => revealObserver.observe(element));

    const counter = document.querySelector('[data-count]');
    if (counter) {
      const finalValue = Number(counter.getAttribute('data-count'));
      const formatter = new Intl.NumberFormat('en-IN');
      const counterObserver = new IntersectionObserver((entries, observer) => {
        const entry = entries[0];
        if (!entry?.isIntersecting) return;
        const startedAt = performance.now();
        const duration = 1250;
        const tick = (now) => {
          const progress = Math.min((now - startedAt) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counter.textContent = formatter.format(Math.round(finalValue * eased));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        observer.disconnect();
      }, { threshold: 0.45 });
      counterObserver.observe(counter);
    }
  })();
</script>

<style>
  .editorial-home {
    --home-cream: #f6f1e7;
    --home-paper: #fffdf8;
    --home-forest: #17483c;
    --home-forest-dark: #0f3029;
    --home-warm: #d65a3a;
    --home-warm-ink: #ad4028;
    --home-black: #14110f;
    --home-rule: #c9c0b2;
    overflow: clip;
    background: var(--home-cream);
    color: var(--home-black);
  }

  .kicker {
    color: currentColor;
    font-family: var(--pc-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .hero {
    padding: clamp(1.25rem, 2.5vw, 2.25rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .hero__edition {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--home-rule);
    color: var(--pc-muted);
    font-family: var(--pc-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
  }

  .hero__grid {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.5rem, 3.5vw, 3rem);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
  }

  .hero h1 {
    position: relative;
    z-index: 2;
    display: grid;
    margin: 0;
    font-family: var(--pc-font-display);
    font-size: clamp(3.75rem, 14.2vw, 9rem);
    font-variation-settings: 'opsz' 144, 'SOFT' 38, 'WONK' 1;
    font-weight: 520;
    letter-spacing: -0.075em;
    line-height: 0.79;
  }

  .hero h1 span,
  .hero h1 em {
    display: block;
    animation: hero-line-in 720ms var(--pc-ease) both;
  }

  .hero h1 span:nth-child(2) {
    animation-delay: 80ms;
  }

  .hero h1 em {
    animation-delay: 160ms;
  }

  @keyframes hero-line-in {
    from {
      opacity: 0;
      transform: translateY(0.42em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero h1 span:nth-child(2) {
    padding-left: clamp(0.75rem, 4vw, 3rem);
  }

  .hero h1 em {
    color: var(--home-warm);
    font-weight: 470;
  }

  .hero__intro {
    display: grid;
    max-width: 37rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--home-rule);
  }

  .hero__intro p {
    max-width: 30rem;
    margin: 0;
    color: var(--pc-text);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.55;
  }

  .hero__intro > span {
    color: var(--home-warm);
    font-size: 2rem;
  }

  .hero__search {
    max-width: 39rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    scroll-margin-top: 2rem;
  }

  .hero__search :global(.calculator-search) {
    max-width: none;
  }

  .hero__search :global(.calculator-search > label) {
    color: var(--home-forest);
  }

  .hero__search :global(.calculator-search__field) {
    border-radius: 0;
    box-shadow: none;
  }

  .hero__search :global(.calculator-search__field--open) {
    border-radius: 0;
  }

  .hero__search :global(.calculator-search__results) {
    border-radius: 0;
  }

  .hero__search :global(.calculator-search__suggestions button) {
    border-radius: 0;
    background: transparent;
  }

  .hero-figure {
    position: relative;
    width: min(100%, 34rem);
    margin: 0;
    justify-self: end;
  }

  .hero-figure__image {
    position: relative;
    aspect-ratio: 29 / 36;
    overflow: hidden;
    background: var(--home-forest-dark);
  }

  .hero-figure__image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 65%, rgb(15 48 41 / 0.15));
    content: '';
    pointer-events: none;
  }

  .hero-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--pc-ease);
  }

  .hero-figure:hover img {
    transform: scale(1.018);
  }

  .hero-figure__stamp {
    position: absolute;
    top: -2rem;
    left: -0.75rem;
    z-index: 3;
    display: grid;
    width: 6.25rem;
    height: 6.25rem;
    place-content: center;
    background: var(--home-warm);
    color: var(--home-black);
    line-height: 1;
    text-align: center;
    transform: rotate(-3deg);
  }

  .hero-figure__stamp span {
    font-family: var(--pc-font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }

  .hero-figure__stamp strong {
    margin-block: 0.3rem;
    font-family: var(--pc-font-display);
    font-size: 1.08rem;
    font-weight: 600;
  }

  .hero-figure figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--home-rule);
    color: var(--pc-muted);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .hero-figure figcaption span:first-child {
    max-width: 27rem;
  }

  .hero-figure figcaption span:last-child {
    flex: 0 0 auto;
    font-family: var(--pc-font-mono);
  }

  .hero-figure__data {
    position: absolute;
    right: -0.5rem;
    bottom: 2.5rem;
    z-index: 3;
    width: min(17rem, 76%);
    padding: 1rem 1.1rem;
    border-top: 3px solid var(--home-warm);
    background: var(--home-paper);
    box-shadow: 0 15px 35px rgb(15 30 24 / 0.13);
  }

  .hero-figure__data > span {
    color: var(--pc-muted);
    font-size: 0.68rem;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-figure__data > strong {
    display: block;
    margin-block: 0.3rem 0.75rem;
    color: var(--home-forest);
    font-family: var(--pc-font-display);
    font-size: clamp(1.65rem, 6vw, 2.4rem);
    font-weight: 570;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .hero-figure__data > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.7rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--pc-border);
    color: var(--pc-muted);
    font-family: var(--pc-font-mono);
    font-size: 0.62rem;
  }

  .hero__footnote {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 0.9rem;
    border-top: 1px solid var(--home-rule);
    color: var(--pc-muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .hero__footnote > span,
  .hero__footnote a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  .hero__footnote > span::before {
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    background: var(--home-warm);
    content: '';
  }

  .hero__footnote a {
    margin-left: auto;
    color: var(--home-forest);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .section-intro {
    display: grid;
    gap: 1.25rem;
  }

  .section-intro h2,
  .catalogue__heading h2,
  .principles__heading h2 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--pc-font-display);
    font-size: clamp(3rem, 7.5vw, 7rem);
    font-variation-settings: 'opsz' 120, 'SOFT' 42;
    font-weight: 520;
    letter-spacing: -0.065em;
    line-height: 0.9;
