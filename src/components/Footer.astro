---
import Brand from './ui/Brand.astro';
import { liveCategories } from '../data/calculators';

const calculatorLinks = [
  ...liveCategories.map((category) => ({
    label: category.title,
    href: `/calculators/category/${category.id}`,
  })),
  { label: 'All calculators', href: '/calculators' },
] as const;
const learnLinks = [
  { label: 'Guides', href: '/guides' },
  { label: 'Methodology', href: '/methodology' },
] as const;
const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
] as const;
const legalLinks = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Disclaimer', href: '/disclaimer' },
] as const;
---

<footer class="site-footer">
  <div class="site-container">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <Brand />
        <p>Money, in plain numbers.</p>
        <span>Transparent financial tools for everyday India.</span>
      </div>

      <nav class="site-footer__links" aria-label="Footer navigation">
        <div>
          <h2>Calculators</h2>
          <ul>
            {calculatorLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Learn</h2>
          <ul>
            {learnLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            {companyLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Legal</h2>
          <ul>
            {legalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} Finova. All rights reserved.</p>
      <p><a href="mailto:getfinova@gmail.com">getfinova@gmail.com</a></p>
      <p><span aria-hidden="true">₹</span> Built for clearer financial decisions in India.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(4.5rem, 9vw, 7rem) 0 1.5rem;
    border-top: 1px solid rgb(246 241 231 / 0.2);
    background: var(--pc-footer-bg);
    color: var(--pc-footer-text);
  }

  .site-footer__main {
    display: grid;
    gap: 4rem;
  }

  .site-footer__brand p {
    max-width: 11ch;
    margin: 1.75rem 0 0.65rem;
    color: var(--pc-footer-text);
    font-family: var(--pc-font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-variation-settings: 'opsz' 72, 'SOFT' 42;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .site-footer__brand > span {
    color: var(--pc-footer-muted);
    font-size: 0.82rem;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  .site-footer__links h2 {
    margin-bottom: 1rem;
    color: var(--pc-footer-muted);
    font-family: var(--pc-font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .site-footer__links ul {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    color: var(--pc-footer-link);
    font-size: 0.85rem;
    transition: color var(--pc-duration-fast) var(--pc-ease);
  }

  .site-footer__links a:hover {
    color: var(--pc-warm);
  }

  .site-footer a:focus-visible {
    outline-color: var(--pc-warm);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 4.5rem;
  }

  .site-footer__bottom p {
    margin: 0;
    color: var(--pc-footer-muted);
    font-size: 0.75rem;
  }

  .site-footer__bottom a {
    color: var(--pc-footer-link);
    transition: color var(--pc-duration-fast) var(--pc-ease);
  }

  .site-footer__bottom a:hover {
    color: var(--pc-warm);
  }

  .site-footer__bottom span {
    margin-right: 0.2rem;
    color: var(--pc-warm);
    font-family: var(--pc-font-display);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .site-footer__main {
      grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
      gap: clamp(3rem, 7vw, 7rem);
    }

    .site-footer__links {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
