---
import Icon from './ui/Icon.astro';
import type { IconName } from '../data/types';

const items: readonly { icon: IconName; title: string; text: string }[] = [
  { icon: 'check', title: 'Free to use', text: 'No signup or paywall' },
  { icon: 'spark', title: 'Instant results', text: 'Updates as inputs change' },
  { icon: 'lock', title: 'Browser-based', text: 'Core calculations run on your device' },
  { icon: 'rupee', title: 'Built for India', text: '₹, lakh/crore and Indian rules' },
];
---

<section class="trust-strip" aria-labelledby="trust-strip-heading">
  <h2 id="trust-strip-heading" class="sr-only">Why people can use Finova with confidence</h2>
  <div class="site-container trust-strip__grid">
    {items.map((item) => (
      <div class="trust-strip__item">
        <Icon name={item.icon} size={19} />
        <div>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-strip {
    border-block: 1px solid var(--pc-border);
    background: rgb(255 255 255 / 0.48);
  }

  .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .trust-strip__item {
    display: flex;
    min-height: 7.25rem;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 1.25rem 0.8rem;
    border-right: 1px solid var(--pc-border);
    border-bottom: 1px solid var(--pc-border);
    color: var(--pc-accent);
  }

  .trust-strip__item:nth-child(even) {
    border-right: 0;
  }

  .trust-strip__item:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .trust-strip__item > div {
    display: grid;
    gap: 0.2rem;
  }

  .trust-strip__item strong {
    color: var(--pc-ink);
    font-size: 0.88rem;
    font-weight: 660;
    line-height: 1.3;
  }

  .trust-strip__item span {
    color: var(--pc-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .trust-strip__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .trust-strip__item,
    .trust-strip__item:nth-child(even) {
      min-height: 6.75rem;
      align-items: center;
      padding: 1.4rem clamp(1rem, 2.5vw, 2rem);
      border-right: 1px solid var(--pc-border);
      border-bottom: 0;
    }

    .trust-strip__item:first-child {
      padding-left: 0;
    }

    .trust-strip__item:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
