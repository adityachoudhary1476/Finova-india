---
import type { IconName } from '../../data/types';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, strokeWidth = 1.7, class: className, label } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
>
  {name === 'arrow-up-right' && <><path d="M7 17 17 7" /><path d="M7 7h10v10" /></>}
  {name === 'book-open' && <><path d="M2.5 5.5A2.5 2.5 0 0 1 5 3h5a2 2 0 0 1 2 2v16a2.5 2.5 0 0 0-2.5-2.5H2.5z" /><path d="M21.5 5.5A2.5 2.5 0 0 0 19 3h-5a2 2 0 0 0-2 2v16a2.5 2.5 0 0 1 2.5-2.5h7z" /></>}
  {name === 'briefcase' && <><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><path d="M3 12h18" /><path d="M10 12v2h4v-2" /></>}
  {name === 'calculator' && <><rect x="4" y="2.5" width="16" height="19" rx="2.5" /><path d="M7.5 6h9v3h-9z" /><path d="M8 13h.01M12 13h.01M16 13h.01M8 17h.01M12 17h.01M16 17h.01" /></>}
  {name === 'chart' && <><path d="M3 3v18h18" /><path d="m7 16 4-5 3 3 5-7" /></>}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'compass' && <><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" /></>}
  {name === 'equal' && <><path d="M5 9h14" /><path d="M5 15h14" /></>}
  {name === 'file-text' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h6" /></>}
  {name === 'grid' && <><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></>}
  {name === 'landmark' && <><path d="m3 9 9-6 9 6" /><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 21h18M2 9h20" /></>}
  {name === 'lock' && <><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
  {name === 'percent' && <><path d="m19 5-14 14" /><circle cx="7" cy="7" r="2" /><circle cx="17" cy="17" r="2" /></>}
  {name === 'piggy-bank' && <><path d="M19 9.5c1.2.5 2 1.7 2 3.2v2.1l-2 .7c-.5 1.1-1.3 2.1-2.4 2.8L16 21h-3v-2H9v2H6l-.8-3.2A7 7 0 0 1 3 12.7C3 8.8 6.6 6 11 6c1 0 2 .1 2.8.4L17 4v4" /><path d="M14 10h.01M3 11H1" /></>}
  {name === 'receipt' && <><path d="M5 3v18l3-2 4 2 4-2 3 2V3l-3 2-4-2-4 2z" /><path d="M9 9h6M9 13h6" /></>}
  {name === 'rupee' && <><path d="M6 4h12M6 8h12M7 4c5 0 7 1 7 4s-2 5-7 5h-1l9 8" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></>}
  {name === 'shield' && <><path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10" /><path d="m9 12 2 2 4-4" /></>}
  {name === 'spark' && <><path d="M12 3v4M12 17v4M3 12h4M17 12h4" /><path d="m5.6 5.6 2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8" /></>}
  {name === 'target' && <><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /></>}
  {name === 'trending-up' && <><path d="m3 17 6-6 4 4 8-8" /><path d="M15 7h6v6" /></>}
  {name === 'wallet' && <><path d="M4 5h14a2 2 0 0 1 2 2v13H4a2 2 0 0 1-2-2V5.5A2.5 2.5 0 0 1 4.5 3H18" /><path d="M15 11h6v5h-6a2.5 2.5 0 0 1 0-5" /></>}
</svg>
