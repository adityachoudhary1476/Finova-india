---
import type { GuideDefinition } from '../../data/types';
import Icon from '../ui/Icon.astro';

interface Props {
  guides: readonly GuideDefinition[];
}

const { guides } = Astro.props;
---

{guides.length > 0 && (
  <section class="related-guides content-section" aria-labelledby="related-guides-title">
    <div class="content-section__heading">
      <span class="eyebrow">Useful context</span>
      <h2 id="related-guides-title">Related guides</h2>
      <p>Understand the ideas behind the calculator before acting on the result.</p>
    </div>
    <div class="related-guides__grid">
      {guides.map((guide) => (
        <a href={`/guides/${guide.slug}`}>
          <span>{guide.category}</span>
          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
          <footer>{guide.readTime} <Icon name="arrow-up-right" size={17} /></footer>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-guides__grid {
    display: grid;
    gap: 0.75rem;
  }

  .related-guides__grid a {
    display: flex;
    min-height: 14rem;
    flex-direction: column;
    padding: 1.35rem;
    border-top: 2px solid var(--pc-ink);
    background: rgb(255 255 255 / 0.45);
    transition: background-color var(--pc-duration-fast) var(--pc-ease);
  }

  .related-guides__grid a:hover {
    background: var(--pc-surface);
  }

  .related-guides__grid > a > span {
    color: var(--pc-accent);
    font-size: 0.75rem;
    font-weight: 680;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .related-guides h3 {
    margin: 2rem 0 0.6rem;
    font-family: var(--pc-font-display);
    font-size: 1.4rem;
    font-weight: 560;
    letter-spacing: -0.025em;
  }

  .related-guides p {
    margin: 0 0 1.25rem;
    color: var(--pc-muted);
    font-size: 0.85rem;
  }

  .related-guides footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    color: var(--pc-accent);
    font-size: 0.78rem;
    font-weight: 650;
  }

  @media (min-width: 40rem) {
    .related-guides__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
